{
  "expo": {
    "name": "Condomus",
    "slug": "condomus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.condomus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.condomus.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 80,
          "backgroundColor": "#1E3A5F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Condomus acessa suas fotos para você escolher uma foto de perfil.",
          "cameraPermission": "O Condomus usa a câmera para você tirar uma foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Condomus usa a câmera para ler o QR code dos visitantes e para fotos de perfil.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "condomus",
    "owner": "matheuspo",
    "extra": {
      "eas": {
        "projectId": "875cc823-8b07-440a-928c-1fde2ca915f4"
      }
    }
  }
}
