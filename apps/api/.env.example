DATABASE_URL="postgresql://condomus:condomus@localhost:5432/condomus"
JWT_SECRET="troque-este-segredo"
PORT=3333

# Segredo das rotas de operação (/admin/*) — mínimo 16 caracteres. Gere um valor aleatório longo.
ADMIN_SECRET="troque-por-um-segredo-admin-longo"

# Object Storage para fotos de perfil (S3 ou compatível: Cloudflare R2, MinIO, etc.)
# Sem essas variáveis a API funciona normalmente, mas as rotas de foto retornam 503.
STORAGE_BUCKET="condomus-fotos"
STORAGE_REGION="us-east-1"
# STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"  # apenas para R2/MinIO
STORAGE_ACCESS_KEY_ID="sua-access-key"
STORAGE_SECRET_ACCESS_KEY="sua-secret-key"
