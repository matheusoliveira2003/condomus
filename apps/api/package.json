{
  "name": "@condomus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate --no-hints && tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate --no-hints && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@condomus/types": "*",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
