generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso do sistema.
enum Papel {
  MORADOR
  PORTEIRO
  SINDICO
}

/// Como a entrada de um visitante com rosto cadastrado foi liberada.
enum VerificacaoEntrada {
  RECONHECIMENTO // o app comparou o rosto ao vivo com o cadastrado e a semelhança passou do limiar
  MANUAL // o porteiro liberou por conta própria, com motivo, depois de conferir o documento
}

enum StatusVisita {
  AGENDADA // pré-autorizada pelo morador
  EM_ANDAMENTO // visitante entrou
  FINALIZADA // visitante saiu
  CANCELADA
}

enum StatusEncomenda {
  AGUARDANDO_RETIRADA
  RETIRADA
}

enum StatusReserva {
  PENDENTE // aguardando aprovação do síndico (já ocupa o horário)
  CONFIRMADA
  RECUSADA
  CANCELADA
}

enum PlanoStatus {
  TRIAL
  ATIVO
  EXPIRADO
  SUSPENSO
}

/// Condomínio: é o tenant (cliente pagante) do sistema.
model Condominio {
  id            String      @id @default(uuid())
  nome          String
  cnpj          String?     @unique
  endereco      String?
  planoStatus   PlanoStatus @default(TRIAL)
  planoExpiraEm DateTime?
  criadoEm      DateTime    @default(now())

  unidades Unidade[]
  usuarios Usuario[]
  areas    AreaComum[]
  avisos   Aviso[]
  rostos   RostoVisitante[]
}

/// Código de convite gerado pelo síndico para o morador se cadastrar numa unidade.
model ConviteUnidade {
  id       String    @id @default(uuid())
  codigo   String    @unique
  expiraEm DateTime
  usadoEm  DateTime?
  criadoEm DateTime  @default(now())

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])
}

/// Apartamento/casa do condomínio.
model Unidade {
  id                String            @id @default(uuid())
  bloco             String
  numero            String
  moradores         Usuario[]
  visitas           Visita[]
  encomendas        Encomenda[]
  reservas          Reserva[]
  convites          ConviteUnidade[]
  visitantesOcultos VisitanteOculto[]
  mensagensChat     MensagemChat[]
  leiturasChat      LeituraChat[]

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  @@unique([condominioId, bloco, numero])
}

/// Visitante que o morador tirou da lista de "visitantes frequentes" da unidade. A lista sai do
/// histórico de visitas; isto só esconde o documento dela. Uma nova autorização volta a mostrá-lo.
model VisitanteOculto {
  id        String   @id @default(uuid())
  /// Documento normalizado (só letras e dígitos, em maiúsculas), como no rosto do visitante.
  documento String
  ocultoEm  DateTime @default(now())

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  @@unique([unidadeId, documento])
}

model Usuario {
  id               String    @id @default(uuid())
  nome             String
  email            String
  senhaHash        String
  /// true quando a senha foi gerada automaticamente pelo sistema; força troca no primeiro login.
  senhaTemporaria  Boolean   @default(false)
  papel            Papel
  ativo            Boolean   @default(true)
  criadoEm         DateTime  @default(now())
  /// Incrementado ao desativar a conta ou trocar a senha; invalida todos os tokens emitidos antes.
  tokenVersion     Int       @default(0)
  /// Muda a cada troca de foto; o app usa como versão para não reaproveitar a imagem antiga do cache.
  /// A foto em si fica no object storage (S3/compatível), não no banco.
  fotoAtualizadaEm DateTime?

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  /// Obrigatório para moradores; nulo para funcionários.
  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  /// Código de recuperação de senha (hash), válido só até codigoRecuperacaoExpira.
  codigoRecuperacaoHash   String?
  codigoRecuperacaoExpira DateTime?

  /// Troca de e-mail pendente de confirmação por código.
  emailPendente     String?
  codigoEmailHash   String?
  codigoEmailExpira DateTime?

  visitasAutorizadas  Visita[]          @relation("VisitaAutorizadaPor")
  visitasRegistradas  Visita[]          @relation("VisitaRegistradaPor")
  rostosRegistrados   RostoVisitante[]
  mensagensChat       MensagemChat[]
  leiturasChat        LeituraChat[]
  encomendasRecebidas Encomenda[]
  avisos              Aviso[]
  reservas            Reserva[]
  dispositivos        DispositivoPush[]

  /// O e-mail é único por condomínio: a mesma pessoa pode ter conta em dois condomínios.
  @@unique([condominioId, email])
  /// O login e a recuperação de senha buscam só pelo e-mail.
  @@index([email])
}

/// Celular registrado para receber notificações push (token do Expo).
model DispositivoPush {
  id           String   @id @default(uuid())
  token        String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Visita {
  id            String       @id @default(uuid())
  nomeVisitante String
  documento     String?
  placaVeiculo  String?
  dataPrevista  DateTime?
  status        StatusVisita @default(AGENDADA)
  entradaEm     DateTime?
  saidaEm       DateTime?
  observacao    String?
  criadoEm      DateTime     @default(now())
  /// Código do convite (QR code) que o visitante apresenta na portaria; só vale enquanto AGENDADA.
  codigoAcesso  String?      @unique

  unidadeId       String
  unidade         Unidade  @relation(fields: [unidadeId], references: [id])
  /// Morador que pré-autorizou (nulo quando a portaria registra direto).
  autorizadoPorId String?
  autorizadoPor   Usuario? @relation("VisitaAutorizadaPor", fields: [autorizadoPorId], references: [id])
  /// Porteiro que registrou a entrada.
  registradoPorId String?
  registradoPor   Usuario? @relation("VisitaRegistradaPor", fields: [registradoPorId], references: [id])

  /// Preenchidos só quando o visitante tinha rosto cadastrado válido na entrada.
  verificacao     VerificacaoEntrada?
  /// Semelhança calculada pelo app (cosseno), registrada junto do reconhecimento ou da recusa.
  semelhanca      Float?
  /// Motivo informado pelo porteiro na liberação manual.
  motivoLiberacao String?
}

/// Rosto de referência de um visitante, cadastrado pela portaria na primeira visita e usado nas
/// seguintes para o porteiro comparar com a foto ao vivo. É dado biométrico (LGPD, art. 11): só
/// existe com o consentimento do visitante, e é apagado após um prazo sem visitas.
/// A foto fica no object storage; aqui ficam só os metadados.
model RostoVisitante {
  id              String   @id @default(uuid())
  /// Documento do visitante normalizado (só letras e dígitos, em maiúsculas): é o que liga as visitas.
  documento       String
  /// Consentimento do visitante, registrado pelo porteiro, e a versão do termo mostrado a ele.
  consentimentoEm DateTime
  termoVersao     String
  /// Última entrada do visitante; a foto é apagada quando passa do prazo sem nenhuma nova.
  ultimaVisitaEm  DateTime
  criadoEm        DateTime @default(now())

  condominioId    String
  condominio      Condominio @relation(fields: [condominioId], references: [id])
  /// Porteiro que cadastrou (ou recadastrou) o rosto.
  registradoPorId String
  registradoPor   Usuario    @relation(fields: [registradoPorId], references: [id])

  @@unique([condominioId, documento])
  @@index([ultimaVisitaEm])
}

model Encomenda {
  id                String          @id @default(uuid())
  descricao         String
  remetente         String?
  status            StatusEncomenda @default(AGUARDANDO_RETIRADA)
  recebidaEm        DateTime        @default(now())
  retiradaEm        DateTime?
  retiradaPor       String?
  /// Lembretes automáticos já enviados no chat porque a encomenda ficou parada na portaria (no máximo 3).
  lembretesEnviados Int             @default(0)
  ultimoLembreteEm  DateTime?

  unidadeId     String
  unidade       Unidade @relation(fields: [unidadeId], references: [id])
  recebidaPorId String
  recebidaPor   Usuario @relation(fields: [recebidaPorId], references: [id])
}

model Aviso {
  id       String   @id @default(uuid())
  titulo   String
  conteudo String
  fixado   Boolean  @default(false)
  criadoEm DateTime @default(now())

  autorId String
  autor   Usuario @relation(fields: [autorId], references: [id])

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])
}

model AreaComum {
  id         String    @id @default(uuid())
  nome       String
  descricao  String?
  capacidade Int?
  ativa      Boolean   @default(true)
  reservas   Reserva[]

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  @@unique([condominioId, nome])
}

model Reserva {
  id           String        @id @default(uuid())
  inicio       DateTime
  fim          DateTime
  status       StatusReserva @default(PENDENTE)
  criadoEm     DateTime      @default(now())
  /// Quando o síndico aprovou ou recusou.
  decididaEm   DateTime?
  motivoRecusa String?

  areaId    String
  area      AreaComum @relation(fields: [areaId], references: [id])
  unidadeId String
  unidade   Unidade   @relation(fields: [unidadeId], references: [id])
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([areaId, inicio])
}

/// De que lado da conversa a mensagem veio. Gravado na mensagem para o histórico não mudar se a pessoa mudar de papel.
enum LadoChat {
  MORADOR
  PORTARIA // porteiro ou síndico
}

/// Mensagem do chat entre a portaria e uma unidade. A conversa é a unidade: todos os moradores dela e
/// toda a portaria veem as mesmas mensagens. Apagada (com a foto) após 90 dias.
model MensagemChat {
  id       String   @id @default(uuid())
  lado     LadoChat
  /// Até 1000 caracteres; nula quando a mensagem é só a foto.
  texto    String?
  /// A foto fica no object storage (chave chat/<unidadeId>/<id>.jpg); aqui só se ela existe.
  temFoto  Boolean  @default(false)
  criadaEm DateTime @default(now())

  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])
  autorId   String
  autor     Usuario @relation(fields: [autorId], references: [id])

  @@index([unidadeId, criadaEm])
  @@index([criadaEm])
}

/// Até onde cada pessoa leu a conversa de uma unidade, para o contador de não lidas.
model LeituraChat {
  lidaEm DateTime

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  unidadeId String
  unidade   Unidade @relation(fields: [unidadeId], references: [id])

  @@id([usuarioId, unidadeId])
}

/// Administrador do sistema: entra no painel web (/admin) e gerencia todos os condomínios. Não pertence a
/// nenhum condomínio e não usa o app. A primeira conta é criada com a chave ADMIN_SECRET.
model Administrador {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  ativo        Boolean  @default(true)
  /// Incrementado ao desativar ou trocar a senha; invalida as sessões abertas no painel.
  tokenVersion Int      @default(0)
  criadoEm     DateTime @default(now())
}
