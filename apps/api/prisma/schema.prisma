generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso do sistema.
enum Papel {
  MORADOR
  PORTEIRO
  SINDICO
}

enum StatusVisita {
  AGENDADA   // pré-autorizada pelo morador
  EM_ANDAMENTO // visitante entrou
  FINALIZADA // visitante saiu
  CANCELADA
}

enum StatusEncomenda {
  AGUARDANDO_RETIRADA
  RETIRADA
}

enum StatusReserva {
  PENDENTE   // aguardando aprovação do síndico (já ocupa o horário)
  CONFIRMADA
  RECUSADA
  CANCELADA
}

enum PlanoStatus {
  TRIAL
  ATIVO
  EXPIRADO
  SUSPENSO
}

/// Condomínio: é o tenant (cliente pagante) do sistema.
model Condominio {
  id            String      @id @default(uuid())
  nome          String
  cnpj          String?     @unique
  endereco      String?
  planoStatus   PlanoStatus @default(TRIAL)
  planoExpiraEm DateTime?
  criadoEm      DateTime    @default(now())

  unidades Unidade[]
  usuarios Usuario[]
  areas    AreaComum[]
  avisos   Aviso[]
}

/// Código de convite gerado pelo síndico para o morador se cadastrar numa unidade.
model ConviteUnidade {
  id       String    @id @default(uuid())
  codigo   String    @unique
  expiraEm DateTime
  usadoEm  DateTime?
  criadoEm DateTime  @default(now())

  unidadeId String
  unidade   Unidade  @relation(fields: [unidadeId], references: [id])
}

/// Apartamento/casa do condomínio.
model Unidade {
  id        String      @id @default(uuid())
  bloco     String
  numero    String
  moradores Usuario[]
  visitas   Visita[]
  encomendas Encomenda[]
  reservas  Reserva[]
  convites  ConviteUnidade[]

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  @@unique([condominioId, bloco, numero])
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash        String
  /// true quando a senha foi gerada automaticamente pelo sistema; força troca no primeiro login.
  senhaTemporaria  Boolean  @default(false)
  papel        Papel
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  /// Incrementado ao desativar a conta ou trocar a senha; invalida todos os tokens emitidos antes.
  tokenVersion Int      @default(0)
  /// Muda a cada troca de foto; o app usa como versão para não reaproveitar a imagem antiga do cache.
  /// A foto em si fica no object storage (S3/compatível), não no banco.
  fotoAtualizadaEm DateTime?

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  /// Obrigatório para moradores; nulo para funcionários.
  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  /// Código de recuperação de senha (hash), válido só até codigoRecuperacaoExpira.
  codigoRecuperacaoHash   String?
  codigoRecuperacaoExpira DateTime?

  /// Troca de e-mail pendente de confirmação por código.
  emailPendente     String?
  codigoEmailHash   String?
  codigoEmailExpira DateTime?

  visitasAutorizadas  Visita[]    @relation("VisitaAutorizadaPor")
  visitasRegistradas  Visita[]    @relation("VisitaRegistradaPor")
  encomendasRecebidas Encomenda[]
  avisos              Aviso[]
  reservas            Reserva[]
  dispositivos        DispositivoPush[]
}

/// Celular registrado para receber notificações push (token do Expo).
model DispositivoPush {
  id           String   @id @default(uuid())
  token        String   @unique
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Visita {
  id               String       @id @default(uuid())
  nomeVisitante    String
  documento        String?
  placaVeiculo     String?
  dataPrevista     DateTime?
  status           StatusVisita @default(AGENDADA)
  entradaEm        DateTime?
  saidaEm          DateTime?
  observacao       String?
  criadoEm         DateTime     @default(now())
  /// Código do convite (QR code) que o visitante apresenta na portaria; só vale enquanto AGENDADA.
  codigoAcesso     String?      @unique

  unidadeId        String
  unidade          Unidade      @relation(fields: [unidadeId], references: [id])
  /// Morador que pré-autorizou (nulo quando a portaria registra direto).
  autorizadoPorId  String?
  autorizadoPor    Usuario?     @relation("VisitaAutorizadaPor", fields: [autorizadoPorId], references: [id])
  /// Porteiro que registrou a entrada.
  registradoPorId  String?
  registradoPor    Usuario?     @relation("VisitaRegistradaPor", fields: [registradoPorId], references: [id])
}

model Encomenda {
  id              String          @id @default(uuid())
  descricao       String
  remetente       String?
  status          StatusEncomenda @default(AGUARDANDO_RETIRADA)
  recebidaEm      DateTime        @default(now())
  retiradaEm      DateTime?
  retiradaPor     String?

  unidadeId       String
  unidade         Unidade         @relation(fields: [unidadeId], references: [id])
  recebidaPorId   String
  recebidaPor     Usuario         @relation(fields: [recebidaPorId], references: [id])
}

model Aviso {
  id       String   @id @default(uuid())
  titulo   String
  conteudo String
  fixado   Boolean  @default(false)
  criadoEm DateTime @default(now())

  autorId  String
  autor    Usuario  @relation(fields: [autorId], references: [id])

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])
}

model AreaComum {
  id         String    @id @default(uuid())
  nome       String
  descricao  String?
  capacidade Int?
  ativa      Boolean   @default(true)
  reservas   Reserva[]

  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])

  @@unique([condominioId, nome])
}

model Reserva {
  id        String        @id @default(uuid())
  inicio    DateTime
  fim       DateTime
  status    StatusReserva @default(PENDENTE)
  criadoEm  DateTime      @default(now())
  /// Quando o síndico aprovou ou recusou.
  decididaEm   DateTime?
  motivoRecusa String?

  areaId    String
  area      AreaComum     @relation(fields: [areaId], references: [id])
  unidadeId String
  unidade   Unidade       @relation(fields: [unidadeId], references: [id])
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([areaId, inicio])
}
