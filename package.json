{
  "name": "condomus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @condomus/api",
    "dev:mobile": "npm run start -w @condomus/mobile",
    "db:up": "brew services start postgresql@16",
    "db:migrate": "npm run db:migrate -w @condomus/api",
    "db:seed": "npm run db:seed -w @condomus/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @condomus/api"
  }
}
